// Valid: Claim is verified before crossing effect boundary
// Should compile without AE-EPISTEMIC-001

fn refund_valid(claim: Claim<RefundDecision>) -> Receipt
uses PaymentGateway:
    { let verified = verify(claim, RefundPolicy, evidence SignedAttestation); return payment_gateway.refund(verified); }

policy RefundPolicy {
    RefundDecision: RefundDecision {
        evidence SignedAttestation "Merchant signed refund authorization"
    }
}

effect PaymentGateway {
    fn refund(decision: Verified<RefundDecision, RefundPolicy>) -> Receipt
}

struct RefundDecision {
    transaction_id: string,
    amount: int,
    reason: string,
}

struct Receipt {
    id: string,
    status: string,
}
