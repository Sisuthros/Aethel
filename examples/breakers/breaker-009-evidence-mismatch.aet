// BREAKER 009 — Evidence kind mismatch: wrong evidence kind for policy
// Policy requires HumanReview but verify() provides SignedAttestation
// Expected: AE-EPISTEMIC-003 (evidence kind mismatch)

struct Order { id: string, total: int }

fn bad_evidence(c: Claim<Order>) -> int
uses Payment:
    {
        let v = verify(c, OrderPolicy, evidence SignedAttestation);
        return payment.charge(v);
    }

effect Payment {
    fn charge(order: Verified<Order, OrderPolicy>) -> int
}

policy OrderPolicy {
    Order: Order {
        evidence HumanReview "requires human sign-off"
    }
}
