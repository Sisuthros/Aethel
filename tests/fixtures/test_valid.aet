fn process_request(proposal: Claim<Approval>) -> Receipt
uses ApprovalGateway:
    { let verified = verify(proposal, ApprovalPolicy); return gateway.approve(verified); }

effect ApprovalGateway {
    fn approve(decision: Verified<Approval, ApprovalPolicy>) -> Receipt
}

policy ApprovalPolicy {
    RequiredCheck: Approval {
        evidence SignedAttestation "Test"
    }
}

struct Approval { amount: int }
struct Receipt { id: string }
